---
---

<section class="block" id="closer" data-audio-src={`${import.meta.env.BASE_URL}audio/closer.wav`}>
	<div class="closer">
		<span class="eyebrow center">Launch your intelligence advantage</span>
		<h2>Stop guessing what AI means for your job.</h2>
		<p>Join the professionals already using Uptomic to see the change coming — and plan for it.</p>
		<a class="btn-primary" href="#">Get My Career Intelligence →</a>
	</div>
</section>

<style>
	.closer {
		border: 1.5px solid var(--line-strong);
		border-radius: 4px;
		background: var(--paper-card);
		padding: 44px 40px;
		text-align: center;
		box-shadow: 6px 6px 0 var(--shadow);
	}

	.closer .eyebrow.center {
		justify-content: center;
	}

	.closer h2 {
		font-size: clamp(1.9rem, 4vw, 2.6rem);
		margin-block: 14px 12px;
	}

	.closer p {
		color: var(--ink-soft);
		font-size: 1.02rem;
		max-width: 46ch;
		margin: 0 auto 26px;
	}

	@media (max-width: 640px) {
		.closer {
			padding: 32px 20px;
		}
	}
</style>
